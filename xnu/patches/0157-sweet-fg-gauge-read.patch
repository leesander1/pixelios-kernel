+static void
+fg_print_value(uint8_t reg, uint16_t v)
+{
+	int32_t s = (int16_t)v;
+
+	switch (reg) {
+	case 0x06:      /* RepSOC: 1/256 % */
+		printf("SWEET FG:   = %u.%02u %%\n", v >> 8, ((v & 0xffu) * 100u) >> 8);
+		break;
+	case 0x09:      /* VCell: 78.125 uV */
+		printf("SWEET FG:   = %u mV\n", (unsigned)(((uint64_t)v * 78125u) / 1000000u));
+		break;
+	case 0x0A:
+	case 0x0B:      /* Current: s16 * 156250 / rsense uA (rsense in 10 uOhm) */
+		printf("SWEET FG:   = %d mA (positive = charging [guess on the sign])\n", (int)((int64_t)s * 156250 / FG_RSENSE / 1000));
+		break;
+	case 0x08:      /* Temp: s16 / 256 degC */
+		printf("SWEET FG:   = %d.%01u C\n", s / 256, (unsigned)(((s < 0 ? -s : s) & 0xff) * 10 / 256));
+		break;
+	case 0x05:
+	case 0x35:      /* capacity: 5 uVh / rsense = 1 mAh at 5 mOhm (max1720x_battery.h reg_to_micro_amp_h) [guess on the exact scale] */
+		printf("SWEET FG:   = %u (raw capacity units, ~mAh at 5 mOhm)\n", v);
+		break;
+	case 0x11:
+	case 0x20:      /* time: 5.625 s */
+		printf("SWEET FG:   = %u min\n", (unsigned)(((uint32_t)v * 5625u) / 1000u / 60u));
+		break;
+	default:
+		break;
+	}
+}
