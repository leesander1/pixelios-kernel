+/* ---- F2 ---- */
+
+/* the controller registers an F2 transfer writes, saved before the first and written back after the last (also after an error) */
+static const uint32_t fg_saved_offs[] = { I2C_ADDR, I2C_FIFO_CTL, I2C_INT_ENABLE, I2C_AUTO_CONF, I2C_CTL };
+static uint32_t fg_saved[sizeof fg_saved_offs / sizeof fg_saved_offs[0]];
