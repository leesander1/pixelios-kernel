+/* one auto-mode message (i2c-exynos5.c exynos5_i2c_message_start), polled; rd = NULL: write the n bytes of tx, else read n bytes. 0 = ok */
+static int
+fg_msg(vm_offset_t i2c, int is_read, const uint8_t *tx, uint8_t *rd, unsigned n, int stop, const char **why)
+{
+	uint32_t ctl, st, ts, fs;
+	uint64_t t0;
+	unsigned got = 0;
+
+	fg_wr(i2c, I2C_INT_STATUS, fg_rd(i2c, I2C_INT_STATUS));            /* clear what is pending (write one to clear, exynos5_i2c_irq :488) */
+	ctl = fg_rd(i2c, I2C_CTL) & ~(CTL_TXCHON | CTL_RXCHON);
+	fg_wr(i2c, I2C_ADDR, SLV_ADDR_MAS(fg.addr));
+	fg_wr(i2c, I2C_FIFO_CTL, FIFO_RX_EN | FIFO_TX_EN | (is_read ? FIFO_RX_TRIG(n) : FIFO_TX_TRIG(n)));
+	fg_wr(i2c, I2C_CTL, ctl | (is_read ? CTL_RXCHON : CTL_TXCHON));
+	fg_wr(i2c, I2C_INT_ENABLE, INT_TRANS_DONE | INT_TRANS_ABORT | INT_NO_DEV_ACK | INT_NO_DEV | INT_TIMEOUT |
+	    (is_read ? (INT_RX_ALMOSTFULL_EN | INT_TRAILING_EN) : INT_TX_ALMOSTEMPTY_EN));
+	if (!is_read) {
+		for (unsigned i = 0; i < n; i++) {
+			fg_wr(i2c, I2C_TX_DATA, tx[i]);
+		}
+	}
+	fg_wr(i2c, I2C_AUTO_CONF, (is_read ? AUTO_READ : 0u) | (stop ? AUTO_STOP : 0u) | n | AUTO_RUN);
+	t0 = fg_now_us();
+	for (;;) {
+		st = fg_rd(i2c, I2C_INT_STATUS);
+		ts = fg_rd(i2c, I2C_TRANS_STATUS);
+		fs = fg_rd(i2c, I2C_FIFO_STATUS);
+		if (is_read) {
+			while (got < n && FIFO_RX_LVL(fs) > 0) {
+				rd[got++] = (uint8_t)fg_rd(i2c, I2C_RX_DATA);
+				fs = fg_rd(i2c, I2C_FIFO_STATUS);
+			}
+		}
+		if ((st & INT_ERRORS) || (ts & TS_ERRORS)) {
+			*why = (ts & (TS_NO_DEV_ACK | TS_NO_DEV)) || (st & INT_NO_DEV) ? "no ack from the device" : "transfer error";
+			printf("SWEET FG: F2 %s: INT_STATUS %#x TRANS_STATUS %#x FIFO_STATUS %#x\n", *why, st, ts, fs);
+			return -1;
+		}
+		/* done: a fresh event in INT_STATUS (cleared above): TRANS_DONE of the exynos7/autov9 variant, or INT_I2C (bit 9) of the
+		 * exynos5 variant together with TRANS_DONE in TRANS_STATUS (exynos5_i2c_irq :491-543; TRANS_STATUS alone is not trusted:
+		 * ABL left its done bit set, run fg1-oriole1); and, for a read, every byte, for a write, the TX FIFO drained */
+		if (((st & INT_TRANS_DONE) || ((st & INT_NO_DEV_ACK) && (ts & TS_TRANS_DONE))) && (is_read ? got == n : (fs & FIFO_TX_EMPTY) != 0)) {
+			break;
+		}
+		if (fg_now_us() - t0 > I2C_TIMEOUT_US) {
+			*why = "timeout";
+			printf("SWEET FG: F2 timeout: INT_STATUS %#x TRANS_STATUS %#x FIFO_STATUS %#x got %u of %u\n", st, ts, fs, got, n);
+			return -2;
+		}
+	}
+	if (stop) {         /* exynos5_i2c_wait_bus_idle */
+		t0 = fg_now_us();
+		while (fg_rd(i2c, I2C_TRANS_STATUS) & TS_MASTER_BUSY) {
+			if (fg_now_us() - t0 > I2C_TIMEOUT_US) {
+				*why = "bus not idle after stop";
+				printf("SWEET FG: F2 %s: TRANS_STATUS %#x\n", *why, fg_rd(i2c, I2C_TRANS_STATUS));
+				return -2;
+			}
+		}
+	}
+	fg_wr(i2c, I2C_INT_ENABLE, 0);
+	return 0;
+}
+
+/* a 16-bit little-endian gauge register: pointer write (no stop), 2-byte read (stop) */
+static int
+fg_reg(vm_offset_t i2c, uint8_t reg, uint16_t *v, const char **why)
+{
+	uint8_t b[2] = { 0, 0 };
+	int rc = fg_msg(i2c, 0, &reg, NULL, 1, 0, why);
+
+	rc = rc ? rc : fg_msg(i2c, 1, NULL, b, 2, 1, why);
+	*v = (uint16_t)(b[0] | b[1] << 8);
+	return rc;
+}
