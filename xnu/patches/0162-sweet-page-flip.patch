+/*
+ * Patch 0162 (boot-arg sweetflip=2, default off; docs/research/44 section 5): the screen-sized surfaces backboardd creates (layer 0 of every
+ * swap: 1125x2436, 4544 bytes per row, 13.9 MB, runs eagl5/6) get their pixels from the scanout carve-out (bsd/dev/sweet_mali.h
+ * SWEET_CARVE_*) instead of a kernel buffer, so AppleCLCD::present() can point the display at them (no CPU copy). Mapped write-combined
+ * everywhere (kernel and clients), like the panel framebuffer surface. A slot is taken here and given back in free(); when no slot is
+ * free, or the surface does not qualify, the ordinary buffer is used and present() copies it as before.
+ */
+static volatile UInt32 sweet_carve_used;        /* bit n = slot n taken */
+
+static int
+sweet_carve_take(void)
+{
+	for (unsigned n = 0; n < SWEET_CARVE_SLOTS;) {
+		UInt32 old = sweet_carve_used;
+		if (old & (1u << n)) {
+			n++;
+			continue;
+		}
+		if (OSCompareAndSwap(old, old | (1u << n), &sweet_carve_used)) {
+			return (int)n;
+		}
+		/* another bit changed meanwhile: look at slot n again */
+	}
+	return -1;
+}
