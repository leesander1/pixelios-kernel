+/* charger status for SweetBattery: st[0..3] = CHG_INT_OK, CHG_DETAILS_00, _01, _02 (read only). 0 = all four read; nonzero also when the
+ * board names no charger */
+int
+sweet_fg_charger(uint8_t st[4])
+{
+	static const uint8_t regs[4] = { 0xB4, 0xB5, 0xB6, 0xB7 };
+	uint16_t v[4];
+	int rc;
+
+	if (!fg.parsed || fg.chg_addr == 0 || !__sync_bool_compare_and_swap(&fg.busy, 0, 1)) {
+		return -1;
+	}
+	rc = fg_bus_ok() ? fg_session(fg.s_i2c, fg.chg_addr, 1, regs, v, 4, 0) : -1;
+	__sync_lock_release(&fg.busy);
+	for (unsigned i = 0; i < 4; i++) {
+		st[i] = rc ? 0 : (uint8_t)v[i];
+	}
+	return rc;
+}
