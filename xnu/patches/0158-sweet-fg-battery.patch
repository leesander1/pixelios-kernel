+/* sweetbattery=2: one gauge sample published; false = no valid sample (the caller publishes the fallback) */
+bool
+SweetBattery::pollGauge(void)
+{
+	unsigned soc256, mv;
+	int ma, centi;
+
+	if (sweet_fg_sample(&soc256, &mv, &ma, &centi) != 0 || mv < 2800 || mv > 4600 || soc256 > 0xFFFFu) {
+		return false;
+	}
+	unsigned percent = (soc256 + 128u) / 256u;
+	if (percent > 100) {
+		percent = 100;
+	}
+	/* No charger register is read yet (the MAX77759 charger is another I2C device): charging = current into the battery
+	 * above the noise [guess on the sign: ModelGauge positive = charging]; external = charging or full. */
+	bool charging = ma > 20;
+	bool full = percent >= 100 && !charging;
+	bool external = charging || full;
+	fTempCenti = centi;
+	fTempMeasured = centi > -4000 && centi < 9000;
+	fSocEstimated = false;
+	publish(percent, mv, ma, external, external, charging, full, true, true);
+	return true;
+}
