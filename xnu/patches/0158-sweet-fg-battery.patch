+static void
+fg_f2(vm_offset_t i2c)
+{
+	uint8_t regs[sizeof fg_regs / sizeof fg_regs[0]];
+	uint16_t vals[sizeof fg_regs / sizeof fg_regs[0]];
+	unsigned i;
+
+	for (i = 0; i < sizeof fg_regs / sizeof fg_regs[0]; i++) {
+		regs[i] = fg_regs[i].reg;
+	}
+	if (!__sync_bool_compare_and_swap(&fg.busy, 0, 1)) {
+		printf("SWEET FG: F2 not started: the controller is in use (F3)\n");
+		return;
+	}
+	printf("SWEET FG: F2: reading the gauge at I2C %#x\n", fg.addr);
+	(void)fg_session(i2c, regs, vals, sizeof regs, 1);
+	__sync_lock_release(&fg.busy);
+}
+
+/* F3: the bus as ABL leaves it (both gates on, USI in I2C mode, pads in function 2 and high); maps once */
+static bool
+fg_bus_ok(void)
+{
+	uint32_t gb = 1u << fg.gate_bit, pc;
+
+	if (!fg.s_i2c) {
+		fg.s_cmu = fg_map(fg.cmu_pa, fg.cmu_size);
+		fg.s_mode = fg_map(fg.mode_pa, 4);
+		fg.s_scl = fg_map(fg.scl_bank, 0x20);
+		fg.s_sda = fg_map(fg.sda_bank, 0x20);
+		if (!fg.s_cmu || !fg.s_mode || !fg.s_scl || !fg.s_sda) {
+			return false;
+		}
+		if (!(fg_rd(fg.s_cmu, fg.c_ipclk) & gb) || !(fg_rd(fg.s_cmu, fg.c_pclk) & gb)) {
+			return false;      /* never map, never read the controller while it is gated */
+		}
+		fg.s_i2c = fg_map(fg.i2c_pa, fg.i2c_size);
+		if (!fg.s_i2c) {
+			return false;
+		}
+	}
+	pc = ((fg_rd(fg.s_scl, PIN_CON) >> (4u * fg.scl_pin)) & 0xfu) | ((fg_rd(fg.s_sda, PIN_CON) >> (4u * fg.sda_pin)) & 0xfu) << 4;
+	return (fg_rd(fg.s_cmu, fg.c_ipclk) & gb) && (fg_rd(fg.s_cmu, fg.c_pclk) & gb) && (fg_rd(fg.s_mode, 0) & fg.mode_mask) == fg.mode_i2c &&
+	       pc == 0x22u && ((fg_rd(fg.s_scl, PIN_DAT) >> fg.scl_pin) & 1u) && ((fg_rd(fg.s_sda, PIN_DAT) >> fg.sda_pin) & 1u);
 }
 
+/* F3 sample for SweetBattery: state of charge in 1/256 %, cell voltage mV, average current mA (positive = into the battery
+ * [guess on the sign]; scale as F2, 2x open: fg-2026-10-27.txt), temperature in 0.01 C. 0 = all four read. */
+int
+sweet_fg_sample(unsigned *soc256, unsigned *mv, int *ma, int *centi_c)
+{
+	static const uint8_t regs[4] = { 0x06, 0x09, 0x0B, 0x08 };     /* RepSOC, VCell, AvgCurrent, Temp (max1720x.h) */
+	uint16_t v[4];
+	int rc;
+
+	if (!fg.parsed || !__sync_bool_compare_and_swap(&fg.busy, 0, 1)) {
+		return -1;
+	}
+	rc = fg_bus_ok() ? fg_session(fg.s_i2c, regs, v, 4, 0) : -1;
+	__sync_lock_release(&fg.busy);
+	if (rc) {
+		return rc;
+	}
+	*soc256 = v[0];
+	*mv = (unsigned)(((uint64_t)v[1] * 78125u) / 1000000u);
+	*ma = (int)((int64_t)(int16_t)v[2] * 156250 / FG_RSENSE / 1000);
+	*centi_c = (int)(int16_t)v[3] * 100 / 256;
+	return 0;
+}
