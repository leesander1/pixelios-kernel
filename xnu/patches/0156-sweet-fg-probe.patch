 extern void sweet_wlan_init(void);          /* bsd/dev/sweet_wlan.c, read-only stage 1, needs boot-arg sweetwlan= and ADT /sweet-wlan */
+extern void sweet_fg_gs101_init(void);      /* bsd/dev/sweet_fg_gs101.c, read-only F1, needs boot-arg sweetfg=1 and ADT /sweet-fg */
 
