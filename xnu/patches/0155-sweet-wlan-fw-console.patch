+/* one RAM word at backplane bp (4-aligned, inside RAM) for the console read: cfg 0x84 is moved to the window that holds bp when it is not there already (*win tracks it) */
+static inline int
+swl_rd_ram(struct swl_wx *x, uint32_t bp, uint32_t *win, uint32_t *v)
+{
+	uint32_t want = bp >= SWW_WIN_TAIL ? SWW_WIN_TAIL : 0;
+
+	if (want != *win) {
+		SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, want));
+		*win = want;
+	}
+	SWW_RD(x, SWW_BAR2, want, bp - want, *v);
+	return 0;
+}
+
+/* W16 console (patch 0155, reads apart from the BAR2 window): the firmware's log ring, read as brcmfmac brcmf_pcie_bus_console_init/_read do (pcie.c:828-891): the hnd_cons_t at console_addr
+ * gives the buffer, its size and the write index; the bytes 0..write index are printed as "SWEET WLAN: FW <line>" (CR dropped, a line cut at SWW_CON_LINE, other non-printable bytes as '.').
+ * Header and buffer must lie inside RAM (anywhere: words at or above 0x400000 are read under the tail window, swl_rd_ram); cfg 0x84 ends at 0. A wrapped ring shows only its newest part
+ * (as brcmfmac, from 0). */
+static inline int
+swl_con(struct swl_wx *x)
+{
+	uint32_t c, end = SWW_RAM_BASE + x->ram_bytes, i, w = 0, ch, win = 0;
+	char line[SWW_CON_LINE + 1u];
+	unsigned n = 0;
+
+	if (x->sh_n <= SWW_SH_CONSOLE || x->sh[SWW_SH_CONSOLE] == 0) {
+		return 0;
 	}
+	c = x->sh[SWW_SH_CONSOLE];
+	if (c < SWW_RAM_BASE || (c & 3u) != 0 || c >= end || end - c < SWW_CON_IDX + 4u) {
+		printf("SWEET WLAN: W16 console at %#010x not read (not inside RAM below %#x)\n", c, end);
+		return 0;
+	}
+	SWW_TRY(swl_rd_ram(x, c + SWW_CON_BUF, &win, &x->con_buf));
+	SWW_TRY(swl_rd_ram(x, c + SWW_CON_SIZE, &win, &x->con_size));
+	SWW_TRY(swl_rd_ram(x, c + SWW_CON_IDX, &win, &x->con_idx));
+	printf("SWEET WLAN: W16 console at %#010x: buffer %#010x size %u write index %u\n", c, x->con_buf, x->con_size, x->con_idx);
+	if (x->con_buf < SWW_RAM_BASE || (x->con_buf & 3u) != 0 || x->con_size == 0 || x->con_size > SWW_CON_MAX || x->con_buf >= end || end - x->con_buf < x->con_size ||
+	    x->con_idx > x->con_size) {
+		printf("SWEET WLAN: W16 console buffer not read (outside RAM below %#x, size above %#x or index beyond the size)\n", end, SWW_CON_MAX);
+	} else {
+		for (i = 0; i < x->con_idx; i++) {
+			if ((i & 3u) == 0) {
+				SWW_TRY(swl_rd_ram(x, x->con_buf + i, &win, &w));
+			}
+			ch = (w >> (8u * (i & 3u))) & 0xFFu;
+			if (ch == '\r') {
+				continue;
+			}
+			if (ch == '\n' || n == SWW_CON_LINE) {
+				line[n] = 0;
+				printf("SWEET WLAN: FW %s\n", line);
+				x->con_lines++;
+				n = 0;
+				if (ch == '\n') {
+					continue;
+				}
+			}
+			line[n++] = (ch >= 0x20u && ch < 0x7Fu) ? (char)ch : '.';
+		}
+		if (n != 0) {
+			line[n] = 0;
+			printf("SWEET WLAN: FW %s\n", line);
+			x->con_lines++;
+		}
+		printf("SWEET WLAN: W16 console %u bytes, %u lines\n", x->con_idx, x->con_lines);
+	}
+	if (win != 0) {
+		SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, 0));
+	}
 	return 0;
 }
 
