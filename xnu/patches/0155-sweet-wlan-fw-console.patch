+ * window 0 (cfg 0x84 back at 0): a console or buffer that is not entirely inside RAM below 0x400000 is logged and not read. A wrapped ring shows only its newest part (as brcmfmac from 0). */
+static inline int
+swl_con(struct swl_wx *x)
+{
+	uint32_t c, end = SWW_RAM_BASE + x->ram_bytes, lim, i, w = 0, ch;
+	char line[SWW_CON_LINE + 1u];
+	unsigned n = 0;
+
+	if (x->sh_n <= SWW_SH_CONSOLE || x->sh[SWW_SH_CONSOLE] == 0) {
+		return 0;
+	}
+	c = x->sh[SWW_SH_CONSOLE];
+	lim = end < SWW_TCM_BYTES ? end : SWW_TCM_BYTES;
+	if (c < SWW_RAM_BASE || (c & 3u) != 0 || c >= lim || lim - c < SWW_CON_IDX + 4u) {
+		printf("SWEET WLAN: W16 console at %#010x not read (not inside RAM below %#x)\n", c, lim);
+		return 0;
+	}
+	SWW_RD(x, SWW_BAR2, 0, c + SWW_CON_BUF, x->con_buf);
+	SWW_RD(x, SWW_BAR2, 0, c + SWW_CON_SIZE, x->con_size);
+	SWW_RD(x, SWW_BAR2, 0, c + SWW_CON_IDX, x->con_idx);
+	printf("SWEET WLAN: W16 console at %#010x: buffer %#010x size %u write index %u\n", c, x->con_buf, x->con_size, x->con_idx);
+	if (x->con_buf < SWW_RAM_BASE || (x->con_buf & 3u) != 0 || x->con_size == 0 || x->con_size > SWW_CON_MAX || x->con_buf >= lim || lim - x->con_buf < x->con_size ||
+	    x->con_idx > x->con_size) {
+		printf("SWEET WLAN: W16 console buffer not read (outside RAM below %#x, size above %#x or index beyond the size)\n", lim, SWW_CON_MAX);
+		return 0;
