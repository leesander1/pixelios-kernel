+	for (i = 0; i < x->con_idx; i++) {
+		if ((i & 3u) == 0) {
+			SWW_RD(x, SWW_BAR2, 0, x->con_buf + i, w);
+		}
+		ch = (w >> (8u * (i & 3u))) & 0xFFu;
+		if (ch == '\r') {
+			continue;
+		}
+		if (ch == '\n' || n == SWW_CON_LINE) {
+			line[n] = 0;
+			printf("SWEET WLAN: FW %s\n", line);
