@@ -1316,10 +1354,14 @@
 static inline int
 swl_fw_pin(struct swl_wx *x)
 {
-	if (x->img_len != SWW_FW_LEN || x->img_crc != SWW_FW_CRC) {
-		printf("SWEET WLAN: W%u firmware identity %u bytes crc %#010x is not the pinned %u bytes crc %#010x\n", x->row, x->img_len, x->img_crc, SWW_FW_LEN, SWW_FW_CRC);
+	if (x->pin_len == 0) {
+		printf("SWEET WLAN: W%u no firmware identity pinned for this board (ADT /sweet-wlan board unknown or missing)\n", x->row);
 		return swl_stop(x, SWW_E_IMG);
 	}
+	if (x->img_len != x->pin_len || x->img_crc != x->pin_crc) {
+		printf("SWEET WLAN: W%u firmware identity %u bytes crc %#010x is not the pinned %u bytes crc %#010x\n", x->row, x->img_len, x->img_crc, x->pin_len, x->pin_crc);
+		return swl_stop(x, SWW_E_IMG);
+	}
 	return 0;
 }
 
