 	uint32_t w14_old, rb;                           /* run D: the word read at address 0 before the store; the word swl_wr() last read back */
+	uint32_t pin_len, pin_crc;                      /* patch 0148: the board's pinned FW identity (swl_fw_pin_for); 0 = unknown board, level 6 refused */
