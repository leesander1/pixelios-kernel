SWEET WLAN firmware pin per board (patch 0148): the level 6 identity pin of 0132 (FW container entry length + CRC32) is looked up by the ADT /sweet-wlan "board" string: bluejay 1764018 bytes crc 0x1153ccff (as before), oriole 1607051 bytes crc 0x54b872bf (oriole-sd1a.210817.015.a4 vendor.img fw_bcmdhd.bin). An unknown or missing board pins nothing, so level 6 stops at the pin (swl_wr SWT_RV, swl_fw_pin, the glue's rv_ok). Levels 1-5 are unchanged.
diff --git a/bsd/dev/sweet_wlan_wr.h b/bsd/dev/sweet_wlan_wr.h
--- a/bsd/dev/sweet_wlan_wr.h
+++ b/bsd/dev/sweet_wlan_wr.h
@@ -80,11 +80,48 @@
 /* Run D (patch 0132, docs/research/43a rows W14, X4; boot-arg sweetwlan=6): the reset vector. DHD stores the first dword of the firmware file as bus->resetinstr (dhd_pcie.c:3934-3936) and, for a CA7,
  * writes it at address 0 after the image, the vars and the rTLV (dhd_pcie.c:10198-10227); the image itself also goes to SWW_RAM_BASE. Firmware IDENTITY pinned for level 6 (not firmware bytes): the
  * container entry's length and CRC32 (observed run wd3, review 0130 finding 8). The NVRAM entry is NOT pinned: it is only CRC-checked against its container record (swl_nv_prep). */
-#define SWW_FW_LEN      1764018u
+/* Patch 0148: the pinned identity is per board. The glue looks it up by the ADT /sweet-wlan "board" string (tools/mkadt.py) and puts it in
+ * swl_wx.pin_len / pin_crc; an unknown board leaves both 0 and level 6 stops at the pin. Values = the FW container entry of each board's
+ * factory image: bluejay = observed run wd3 (review 0130 finding 8); oriole = fw_bcmdhd.bin of oriole-sd1a.210817.015.a4 vendor.img
+ * (tools/extract-wlanfw.sh, 2026-10-27: 1607051 bytes, zlib crc32 0x54b872bf). */
+#define SWW_FW_LEN      1764018u        /* bluejay: also the largest accepted image (SWW_IMG_MAX) */
 #define SWW_FW_CRC      0x1153ccffu
+#define SWW_FW_LEN_ORIOLE 1607051u
+#define SWW_FW_CRC_ORIOLE 0x54b872bfu
 #define SWW_SEC_SBOOT   0x2u            /* DAR_SEC_SBOOT_MASK, include_pcie_core.h:1161; tested on the word at bp 0 because PCIe core 0x83c rev 72 < 74 (dhd_pcie.c:11741, 10208-10222) */
 #define SWW_CORE_PCIE2  0x83c           /* PCIE2_CORE_ID, include_hndsoc.h:200; the core whose rev is DHD's buscorerev */
 _Static_assert(SWW_FW_LEN == SWW_IMG_MAX, "the pinned firmware is the largest accepted image");
+_Static_assert(SWW_FW_LEN_ORIOLE <= SWW_IMG_MAX, "every pinned firmware fits the image bound");
+
+/* patch 0148: the pinned FW identity of a board (exact string, n bytes, a trailing NUL counted or not); 0 found, -1 unknown (both set to 0) */
+static inline int
+swl_fw_pin_for(const char *board, unsigned n, uint32_t *len, uint32_t *crc)
+{
+	static const struct { char name[8]; uint32_t len, crc; } pins[] = {
+		{ "bluejay", SWW_FW_LEN, SWW_FW_CRC },
+		{ "oriole", SWW_FW_LEN_ORIOLE, SWW_FW_CRC_ORIOLE },
+	};
+	*len = 0;
+	*crc = 0;
+	if (board == NULL) {
+		return -1;
+	}
+	if (n > 0 && board[n - 1] == '\0') {
+		n--;
+	}
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		unsigned k = 0;
+		while (k < n && k < sizeof(pins[i].name) && pins[i].name[k] != '\0' && pins[i].name[k] == board[k]) {
+			k++;
+		}
+		if (k == n && k < sizeof(pins[i].name) && pins[i].name[k] == '\0') {
+			*len = pins[i].len;
+			*crc = pins[i].crc;
+			return 0;
+		}
+	}
+	return -1;
+}
 
 enum { SWW_CFG = 1, SWW_ATU, SWW_BAR0, SWW_BAR2, SWW_ELBI, SWW_ISO };
 
