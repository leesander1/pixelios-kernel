-	if ((p->flags & SWT_RV) && (x->img == NULL || x->img_len != SWW_FW_LEN || x->img_crc != SWW_FW_CRC || val != swl_img_word(x, 0))) {
+	if ((p->flags & SWT_RV) && (x->img == NULL || x->pin_len == 0 || x->img_len != x->pin_len || x->img_crc != x->pin_crc || val != swl_img_word(x, 0))) {
