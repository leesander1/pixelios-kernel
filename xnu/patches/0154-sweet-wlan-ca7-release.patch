+	}
+	SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, 0));
+	if (x->sh_addr != 0 && x->sh_addr < SWW_WIN_TAIL) {
+		SWW_TRY(swl_sh_read(x, 0));
+	}
+	if (x->sh_addr == 0) {
+		printf("SWEET WLAN: W16 no shared-area address after %u reads (last RAM word %#010x, token %#010x)\n", x->sh_polls, v, x->tok);
+	} else {
+		printf("SWEET WLAN: W16 shared area at %#010x after %u reads, %u words:\n", x->sh_addr, x->sh_polls, x->sh_n);
+		for (i = 0; i < x->sh_n; i += 4u) {
+			printf("SWEET WLAN: W16 sh+%#04x %#010x %#010x %#010x %#010x\n", 4u * i, x->sh[i], i + 1u < x->sh_n ? x->sh[i + 1u] : 0, i + 2u < x->sh_n ? x->sh[i + 2u] : 0,
+			    i + 3u < x->sh_n ? x->sh[i + 3u] : 0);
+		}
