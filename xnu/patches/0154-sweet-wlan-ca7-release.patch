+static inline int
+swl_w15(struct swl_wx *x)
+{
+	uint32_t v;
+
+	x->row = 15;
+	SWW_TRY(swl_img_check(x));
+	SWW_TRY(swl_fw_pin(x));
+	SWW_RD(x, SWW_BAR2, 0, 0, v);
+	if (v != swl_img_word(x, 0)) {
+		printf("SWEET WLAN: W15 backplane 0 holds %#010x, not the reset vector %#010x\n", v, swl_img_word(x, 0));
+		return swl_stop(x, SWW_E_STATE);
+	}
+	SWW_TRY(swl_win(x, SWW_WIN_CA7WRAP));
+	SWW_TRY(swl_core_reset(x, SWW_WIN_CA7WRAP, 0x3u, 0x1u));
+	printf("SWEET WLAN: W15 CA7 released (CPUHALT clear), the firmware runs\n");
+	return swl_done(x, SWF_W15);
