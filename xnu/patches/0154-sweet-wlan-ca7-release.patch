+/* the shared-area words at backplane a (4-aligned, inside RAM) under BAR2 window win, as many as fit below ram_end and inside that window; reads only */
+static inline int
+swl_sh_read(struct swl_wx *x, uint32_t win)
+{
+	uint32_t a, end = SWW_RAM_BASE + x->ram_bytes;
+
+	while (x->sh_n < SWW_SH_WORDS) {
+		a = x->sh_addr + 4u * x->sh_n;
+		if (a >= end || a < win || a - win > (win ? SWW_LAST_HI_MAX : SWW_TCM_BYTES - 4u)) {
+			break;
+		}
+		SWW_RD(x, SWW_BAR2, win, a - win, x->sh[x->sh_n]);
+		x->sh_n++;
+	}
+	return 0;
+}
+
+/* W16: the firmware's handshake (dhd_pcie.c:13613-13705; brcmfmac-pcie.c:1740-1770): the last RAM word held the length token (W12); a running firmware replaces it with the address of its
+ * pciedev_shared_t. Read it every SWW_SH_US, at most SWW_SH_POLLS times, with cfg 0x84 on the tail window (as W11..W13); a 4-aligned value inside RAM below the last word is the address, and
+ * SWW_SH_WORDS words there are logged raw. A timeout is a result, not a stop; all-ones (link gone) is a stop. Nothing is stored apart from the window. */
+static inline int
+swl_w16(struct swl_wx *x)
+{
+	uint32_t v = 0, last, end = SWW_RAM_BASE + x->ram_bytes;
+	unsigned i, shown = 0;
+
+	x->row = 16;
+	x->armed = SWW_RG_CA;   /* the ARM runs: a stop anywhere in W16, also before the first store, puts it back into reset */
+	SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, SWW_WIN_TAIL));
+	last = x->tok;
+	for (i = 0; i < SWW_SH_POLLS; i++) {
+		SWW_RD(x, SWW_BAR2, SWW_WIN_TAIL, end - 4u - SWW_WIN_TAIL, v);
+		x->sh_polls = i + 1u;
+		if (v != last && shown < 8u) {
+			printf("SWEET WLAN: W16 read %u (+%u ms) last RAM word %#010x\n", i, i * (SWW_SH_US / 1000u), v);
+			shown++;
+		}
+		last = v;
+		if (v == 0xFFFFFFFFu) {
+			return swl_stop(x, SWW_E_DEAD);
+		}
+		if (v != x->tok && v >= SWW_RAM_BASE && v < end - 4u && (v & 3u) == 0) {
+			x->sh_addr = v;
+			break;
+		}
+		if (i + 1u < SWW_SH_POLLS) {
+			swl_delay(x, SWW_SH_US);
+		}
+	}
